{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run UIUA",
            "type": "shell",
            "command": "uiua run \"${file}\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Uiua Watcher",
            "type": "shell",
            "command": "uiua watch --clear",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ],
}